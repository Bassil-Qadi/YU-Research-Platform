# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (local: docker-compose up -d)
MONGODB_URI=mongodb://localhost:27017/research-platform

# NextAuth / Auth.js v5
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Legacy aliases (optional; AUTH_* preferred in v5)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Account seeded by `npm run seed` (development only — never used at sign-in)
DEV_USER_EMAIL=demo@university.edu
DEV_USER_PASSWORD=demo123456

# SAML / university SSO (configure when ready)
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_CLIENT_ID=
SAML_CLIENT_SECRET=
SAML_ISSUER=

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis (Phase 2+ — sessions, rate limiting)
REDIS_URL=redis://localhost:6379

# File storage — Cloudinary (avatars and project files)
# Copy the "API environment variable" straight from the Cloudinary dashboard:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# The cloud name is the part after "@" — it is NOT the product environment's
# display name, which is a different string.
CLOUDINARY_URL=

# Or set the three separately instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (registration, approvals, invitations, join requests)
RESEND_API_KEY=
# Resend's shared sender only delivers to your own account address. Point this
# at a verified domain to send to anyone else.
EMAIL_FROM="Research Platform <onboarding@resend.dev>"
